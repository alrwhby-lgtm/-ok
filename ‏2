    function deleteSpecificItem() {
        let itemToDelete = prompt("أدخل النص أو الاسم أو رقم اللوحة أو الملاحظة التي تريد مسحها تماماً:");
        if (!itemToDelete) return;

        itemToDelete = itemToDelete.trim();
        let found = false;

        let keysToCheck = ['seller_', 'buyer_', 'owner_', 'car_', 'saved_contract_'];
        keysToCheck.forEach(prefix => {
            let fullKey = prefix + itemToDelete;
            if (localStorage.getItem(fullKey)) {
                localStorage.removeItem(fullKey);
                found = true;
            }
        });

        ['all_sellers_list', 'all_buyers_list', 'all_owners_list', 'all_cars_list'].forEach(listKey => {
            let list = JSON.parse(localStorage.getItem(listKey)) || [];
            let index = list.indexOf(itemToDelete);
            if (index > -1) {
                list.splice(index, 1);
                localStorage.setItem(listKey, JSON.stringify(list));
                found = true;
            }
        });

        [1, 2, 3].forEach(indexNum => {
            let noteListKey = 'all_notes_list_' + indexNum;
            let notesList = JSON.parse(localStorage.getItem(noteListKey)) || [];
            let noteIndex = notesList.indexOf(itemToDelete);
            if (noteIndex > -1) {
                notesList.splice(noteIndex, 1);
                localStorage.setItem(noteListKey, JSON.stringify(notesList));
                found = true;
            }
        });

        if (found) {
            alert("تم حذف '" + itemToDelete + "' بنجاح من الذاكرة!");
            location.reload();
        } else {
            alert("لم يتم العثور على '" + itemToDelete + "' في الذاكرة.");
        }
    }

