<script>
    function getValidUsers() {
        let storedUsers = localStorage.getItem('app_valid_users');
        if (storedUsers) {
            try { return JSON.parse(storedUsers); } catch(e) {}
        }
        let defaultUsers = {
            "وهبي": "1989",
            "وميض": "1985",
            "انور": "0000",
            "فاتك": "1111"
        };
        localStorage.setItem('app_valid_users', JSON.stringify(defaultUsers));
        return defaultUsers;
    }

    let currentLoggedInUser = "";
    let qrCodeInstance = null;
    let priceQrCodeInstance = null;
    let isContractLocked = false;
    let inactivityTimer = null;

    function resetInactivityTimer() {
        clearTimeout(inactivityTimer);
        inactivityTimer = setTimeout(() => {
            triggerAutoLock();
        }, 900000);
    }

    function triggerAutoLock() {
        currentLoggedInUser = "";
        document.getElementById('loginUsername').value = "";
        document.getElementById('loginPassword').value = "";
        document.getElementById('loginError').innerText = "تم قفل النظام تلقائياً لعدم النشاط (15 دقيقة). يرجى إعادة تسجيل الدخول.";
        document.getElementById('loginTitle').innerText = "قفل الخمول - تسجيل الدخول";
        document.getElementById('loginOverlay').style.display = 'flex';
        document.getElementById('loginPassword').focus();
    }

    window.onload = function() {
        ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'].forEach(eventName => {
            document.addEventListener(eventName, resetInactivityTimer, true);
        });
        resetInactivityTimer();

        document.getElementById('loginPassword').focus();

        let now = new Date();
        let year = now.getFullYear();
        let month = String(now.getMonth() + 1).padStart(2, '0');
        let day = String(now.getDate()).padStart(2, '0');

        let hours = now.getHours();
        let minutes = String(now.getMinutes()).padStart(2, '0');
        let ampm = hours >= 12 ? 'م' : 'ص';
        hours = hours % 12;
        hours = hours ? hours : 12;
        let formattedHours = String(hours).padStart(2, '0');

        let fullDateString = year + '/' + month + '/' + day + ' - الساعة ' + formattedHours + ':' + minutes + ' ' + ampm;
        let shortDateString = year + '/' + month + '/' + day;

        document.getElementById('fullDateTime').value = fullDateString;

        generateUniqueContractNumber();

        let subDateElements = document.getElementsByClassName('subDate');
        for (let i = 0; i < subDateElements.length; i++) {
            subDateElements[i].innerText = shortDateString;
        }

        updatePlateDisplay();
        initQRCode();
        updateQRCode();
        updatePriceQRCode();
        updateBuyersListUI();
        updateSellersListUI();
        updateOwnersListUI();
        updateCarsListUI();
        updateNotesListUI(1);
        updateNotesListUI(2);
        updateNotesListUI(3);
    };

    function generateUniqueContractNumber() {
        let lastNumStr = localStorage.getItem('last_contract_number');
        let nextNum = 1;
        if (lastNumStr) {
            nextNum = parseInt(lastNumStr, 10) + 1;
        }

        while (localStorage.getItem('saved_contract_' + String(nextNum).padStart(6, '0'))) {
            nextNum++;
        }

        let formattedNum = String(nextNum).padStart(6, '0');
        document.getElementById('contractNumDisplay').innerText = formattedNum;
        localStorage.setItem('last_contract_number', formattedNum);
    }

    function performLogin() {
        let usernameInput = document.getElementById('loginUsername').value.trim();
        let passwordInput = document.getElementById('loginPassword').value.trim();
        let errorDiv = document.getElementById('loginError');
        let validUsers = getValidUsers();

        if (validUsers[usernameInput] && validUsers[usernameInput] === passwordInput) {
            currentLoggedInUser = usernameInput; 
            document.getElementById('loginOverlay').style.display = 'none';
            
            if (usernameInput === "وهبي") {
                document.getElementById('manageUsersBtn').style.display = 'inline-block';
            } else {
                document.getElementById('manageUsersBtn').style.display = 'none';
            }

            resetInactivityTimer();
        } else {
            errorDiv.innerText = "اسم المستخدم أو كلمة المرور غير صحيحة!";
        }
    }

    function checkEnter(event) {
        if (event.key === "Enter") {
            performLogin();
        }
    }

    function openManageUsersModal() {
        if (currentLoggedInUser !== "وهبي") {
            alert("عذراً، هذه الصلاحية مخصصة للمدير (وهبي) فقط!");
            return;
        }

        let usersWindow = window.open('', '_blank');
        let validUsers = getValidUsers();

        let htmlContent = `
            <html lang="ar" dir="rtl">
            <head>
                <meta charset="UTF-8">
                <title>إدارة الموظفين والأرقام السرية</title>
                <style>
                    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 20px; background: #f4f6f9; color: #333; }
                    h2 { color: #0b1e36; text-align: center; border-bottom: 2px solid #c5a059; padding-bottom: 10px; margin-bottom: 20px; }
                    .add-box { background: #fff; padding: 15px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); margin-bottom: 20px; display: flex; gap: 10px; align-items: center; justify-content: center; }
                    .add-box input { padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; width: 200px; outline: none; }
                    .add-box button { padding: 8px 15px; background: #28a745; color: #fff; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; }
                    table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 6px; overflow: hidden; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
                    th, td { border: 1px solid #ddd; padding: 10px 15px; font-size: 14px; text-align: center; }
                    th { background: #0b1e36; color: #f3e5ab; }
                    tr:nth-child(even) { background: #f9f9f9; }
                    .btn { padding: 5px 10px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 12px; margin: 0 3px; }
                    .btn-edit { background: #ffc107; color: #000; }
                    .btn-delete { background: #dc3545; color: #fff; }
                </style>
            </head>
            <body>
                <h2>لوحة تحكم المدير (وهبي) - إدارة الموظفين</h2>

                <div class="add-box">
                    <strong>إضافة موظف جديد:</strong>
                    <input type="text" id="newUsername" placeholder="اسم الموظف">
                    <input type="text" id="newPassword" placeholder="الرقم السري">
                    <button onclick="addNewUser()">إضافة موظف ➕</button>
                </div>

                <table>
                    <thead>
                        <tr>
                            <th>اسم الموظف</th>
                            <th>الرقم السري (مكشوف للإدارة)</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
        `;

        for (let user in validUsers) {
            htmlContent += `
                <tr>
                    <td><strong>${user}</strong> ${user === 'وهبي' ? '(المدير)' : ''}</td>
                    <td><span style="font-family: monospace; font-size: 16px; color: #d9534f; font-weight: bold;">${validUsers[user]}</span></td>
                    <td>
                        <button class="btn btn-edit" onclick="changeUserPassword('${user}')">تغيير الرقم السري 🔑</button>
                        ${user !== 'وهبي' ? `<button class="btn btn-delete" onclick="deleteUser('${user}')">حذف الموظف 🗑️</button>` : '<span style="color:#888; font-size:12px;">حساب رئيسي</span>'}
                    </td>
                </tr>
            `;
        }

        htmlContent += `
                    </tbody>
                </table>

                <script>
                    function addNewUser() {
                        let name = document.getElementById('newUsername').value.trim();
                        let pass = document.getElementById('newPassword').value.trim();
                        if(!name || !pass) {
                            alert("يرجى إدخال اسم الموظف والرقم السري!");
                            return;
                        }
                        let users = JSON.parse(window.opener.localStorage.getItem('app_valid_users'));
                        if(users[name]) {
                            alert("اسم الموظف موجود مسبقاً!");
                            return;
                        }
                        users[name] = pass;
                        window.opener.localStorage.setItem('app_valid_users', JSON.stringify(users));
                        alert("تمت إضافة الموظف بنجاح!");
                        location.reload();
                    }

                    function changeUserPassword(username) {
                        let newPass = prompt("أدخل الرقم السري الجديد للموظف (" + username + "):");
                        if(newPass !== null && newPass.trim() !== "") {
                            let users = JSON.parse(window.opener.localStorage.getItem('app_valid_users'));
                            users[username] = newPass.trim();
                            window.opener.localStorage.setItem('app_valid_users', JSON.stringify(users));
                            alert("تم تغيير الرقم السري بنجاح!");
                            location.reload();
                        }
                    }

                    function deleteUser(username) {
                        if(confirm("هل أنت متأكد من حذف الموظف (" + username + ")؟")) {
                            let users = JSON.parse(window.opener.localStorage.getItem('app_valid_users'));
                            delete users[username];
                            window.opener.localStorage.setItem('app_valid_users', JSON.stringify(users));
                            alert("تم حذف الموظف بنجاح!");
                            location.reload();
                        }
                    }
                <\/script>
            </body>
            </html>
        `;

        usersWindow.document.write(htmlContent);
        usersWindow.document.close();
    }

    function initQRCode() {
        let container = document.getElementById("qrcode");
        container.innerHTML = "";
        qrCodeInstance = new QRCode(container, {
            text: "CHASSIS",
            width: 50,
            height: 50,
            colorDark: "#0b1e36",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.M
        });

        let priceContainer = document.getElementById("priceQRCode");
        priceContainer.innerHTML = "";
        priceQrCodeInstance = new QRCode(priceContainer, {
            text: "PRICE",
            width: 42,
            height: 42,
            colorDark: "#0b1e36",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.M
        });
    }

    function updateQRCode() {
        let vinVal = document.getElementById('vinNumber').value.trim();
        let textToEncode = vinVal.length > 0 ? vinVal : "CHASSIS";
        if (qrCodeInstance) {
            qrCodeInstance.makeCode(textToEncode);
        }
    }

    function updatePriceQRCode() {
        let priceVal = document.getElementById('priceNum').value.trim();
        let currencyVal = document.getElementById('currencySelect').value;
        let textToEncode = priceVal.length > 0 ? priceVal + " " + currencyVal : "PRICE";
        if (priceQrCodeInstance) {
            priceQrCodeInstance.makeCode(textToEncode);
        }
    }

    function updatePlateDisplay() {
        let plateInput = document.getElementById('plateNumber').value.trim();
        let letterSelect = document.getElementById('plateLetterSelect');
        let codeSelect = document.getElementById('plateCodeSelect');
        
        let letterVal = letterSelect.value;
        let selectVal = codeSelect.value;
        
        document.getElementById('plateVisualText').innerText = plateInput;
        document.getElementById('plateLetterVisual').innerText = (letterSelect.selectedIndex > 0) ? letterVal : "";
        document.getElementById('plateSideVisual').innerText = (codeSelect.selectedIndex > 0) ? selectVal : "";
    }

    function lockContractFields(lock) {
        isContractLocked = lock;
        let banner = document.getElementById('lockStatusBanner');
        let unlockBtn = document.getElementById('unlockBtn');
        
        let inputs = document.querySelectorAll('.contract-container input[type="text"], .contract-container input[type="number"], .contract-container textarea, .contract-container select');
        
        inputs.forEach(input => {
            if (input.id !== 'fullDateTime') {
                if (lock) {
                    input.setAttribute('readonly', true);
                    if (input.tagName === 'SELECT') {
                        input.setAttribute('disabled', true);
                    }
                } else {
                    input.removeAttribute('readonly');
                    if (input.tagName === 'SELECT') {
                        input.removeAttribute('disabled');
                    }
                }
            }
        });

        if (lock) {
            banner.style.display = 'block';
            unlockBtn.style.display = 'inline-block';
        } else {
            banner.style.display = 'none';
            unlockBtn.style.display = 'none';
        }
    }

    function unlockContractForEditing() {
        let pin = prompt("أدخل الرقم السري لفك القفل:");
        let validUsers = getValidUsers();
        if (pin === "1989" || (currentLoggedInUser === "وهبي" && pin === validUsers["وهبي"])) {
            lockContractFields(false);
            alert("تم فك قفل العقد بنجاح. يمكنك الآن التعديل بحرية.");
        } else if (pin !== null) {
            alert("الرقم السري غير صحيح!");
        }
    }

    function performAutoSave() {
        if (isContractLocked) return;

        let contractNum = document.getElementById('contractNumDisplay').innerText.trim();
        
        let contractData = {
            contractNum: contractNum,
            fullDateTime: document.getElementById('fullDateTime').value,
            createdBy: currentLoggedInUser || "غير معروف",
            seller: {
                name: document.getElementById('sellerName').value,
                id: document.getElementById('sellerId').value,
                address: document.getElementById('sellerAddress').value,
                mahalla: document.getElementById('sellerMahalla').value,
                zuqaq: document.getElementById('sellerZuqaq').value,
                dar: document.getElementById('sellerDar').value,
                phone: document.getElementById('sellerPhone').value
            },
            buyer: {
                name: document.getElementById('buyerName').value,
                id: document.getElementById('buyerId').value,
                address: document.getElementById('buyerAddress').value,
                mahalla: document.getElementById('buyerMahalla').value,
                zuqaq: document.getElementById('buyerZuqaq').value,
                dar: document.getElementById('buyerDar').value,
                phone: document.getElementById('buyerPhone').value
            },
            owner: {
                name: document.getElementById('ownerName').value,
                id: document.getElementById('ownerId').value,
                address: document.getElementById('ownerAddress').value,
                mahalla: document.getElementById('ownerMahalla').value,
                zuqaq: document.getElementById('ownerZuqaq').value,
                dar: document.getElementById('ownerDar').value,
                phone: document.getElementById('ownerPhone').value
            },
            car: {
                type: document.getElementById('carType').value,
                model: document.getElementById('carModel').value,
                color: document.getElementById('carColor').value,
                vin: document.getElementById('vinNumber').value,
                docNum: document.getElementById('carDocNum').value,
                plate: document.getElementById('plateNumber').value,
                letter: document.getElementById('plateLetterSelect').value,
                code: document.getElementById('plateCodeSelect').value
            },
            financial: {
                priceNum: document.getElementById('priceNum').value,
                currency: document.getElementById('currencySelect').value,
                priceWords: document.getElementById('priceWords').value,
                paidNum: document.getElementById('paidNum').value,
                remainingNum: document.getElementById('remainingNum').value,
                paymentMethod: document.getElementById('paymentMethod').value
            },
            notes: {
                note1: document.getElementById('note1').value,
                note2: document.getElementById('note2').value,
                note3: document.getElementById('note3').value
            }
        };

        localStorage.setItem('saved_contract_' + contractNum, JSON.stringify(contractData));
        localStorage.setItem('last_contract_number', contractNum);
    }

    function autoSaveAndPrint() {
        performAutoSave();
        window.print();
    }

    function autoSaveAndPDF() {
        performAutoSave();
        if (window.chrome && window.chrome.webview) {
            window.chrome.webview.postMessage('save_pdf');
        } else {
            window.print();
