<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>عقد بيع وشراء مركبة - معرض أبو ظبي</title>
    <!-- مكتبة توليد QR Code (qrcode.js) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        :root {
            --main-color: #0b1e36;
            --gold-color: #c5a059;
            --gold-light: #f3e5ab;
            --border-color: #333;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #525659;
            padding: 10px 0;
        }

        /* شاشة تسجيل الدخول */
        #loginOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(11, 30, 54, 0.95);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .login-box {
            background: #fff;
            padding: 30px;
            border-radius: 8px;
            width: 350px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            border: 2px solid var(--gold-color);
            text-align: center;
        }

        .login-box h2 {
            color: var(--main-color);
            margin-bottom: 20px;
            font-size: 20px;
        }

        .login-group {
            margin-bottom: 15px;
            text-align: right;
        }

        .login-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            font-size: 13px;
            color: #333;
        }

        .login-group input {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
        }

        .btn-login {
            background-color: var(--main-color);
            color: white;
            border: none;
            padding: 10px;
            width: 100%;
            border-radius: 4px;
            font-weight: bold;
            font-size: 15px;
            cursor: pointer;
            margin-top: 10px;
        }

        .btn-login:hover {
            background-color: #16385e;
        }

        .login-error {
            color: #dc3545;
            font-size: 12px;
            margin-top: 10px;
            font-weight: bold;
        }

        .contract-container {
            background: #fff;
            width: 210mm;
            height: 297mm;
            margin: 0 auto;
            border: 4px double var(--gold-color);
            outline: 2px solid var(--main-color);
            outline-offset: -6px;
            padding: 5mm 10mm 4mm 10mm;
            box-shadow: 0 0 15px rgba(0,0,0,0.4);
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
        }

        .lock-status-banner {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            background: #dc3545;
            color: white;
            text-align: center;
            font-size: 11px;
            font-weight: bold;
            padding: 2px;
            display: none;
            z-index: 10;
        }

        .watermark-bg {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 750px;
            height: 750px;
            opacity: 0.85;
            z-index: 0;
            pointer-events: none;
            object-fit: contain;
            filter: sepia(100%) hue-rotate(5deg) saturate(300%);
        }

        .main-content {
            display: flex;
            flex-direction: column;
            position: relative;
            z-index: 1;
            margin-top: 10px;
        }

        .header {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2px;
            min-height: 110px;
        }

        .header-left-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .contract-no-box {
            border: 2px solid var(--gold-color);
            border-radius: 6px;
            padding: 2px 6px;
            text-align: center;
            width: 110px;
            background: linear-gradient(to bottom, #fff, #fdfcf7);
        }

        .contract-no-box .title {
            font-weight: bold;
            font-size: 11px;
            color: #333;
        }

        .contract-no-box .number {
            font-size: 15px;
            font-weight: bold;
            color: #d9534f;
            letter-spacing: 1px;
        }

        .header-qr-box {
            background: #fff;
            padding: 2px;
            border: 1px solid var(--gold-color);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .header-qr-box canvas, .header-qr-box img {
            display: block;
            width: 50px !important;
            height: 50px !important;
        }

        .header-center {
            text-align: center;
            flex-grow: 1;
            margin: 0 110px 0 180px;
        }

        .header-center h3 {
            margin: 0;
            font-size: 11px;
            color: #555;
        }

        .header-center h1 {
            margin: 1px 0;
            font-size: 20px;
            color: var(--main-color);
            border-bottom: 2px solid var(--gold-color);
            display: inline-block;
            padding-bottom: 1px;
        }

        .header-center h1::before, .header-center h1::after {
            content: " ❖ ";
            color: var(--gold-color);
            font-size: 14px;
        }

        .header-center .sub-title {
            background: linear-gradient(135deg, var(--main-color), #1b365d);
            color: var(--gold-light);
            border: 1px solid var(--gold-color);
            padding: 1px 10px;
            border-radius: 10px;
            font-size: 9.5px;
            display: inline-block;
            font-weight: bold;
        }

        .logo-box {
            position: absolute;
            top: 0;
            left: 0;
            text-align: center;
            width: 170px;
            height: 105px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-img {
            max-width: 170px;
            max-height: 102px;
            object-fit: contain;
        }

        .date-line {
            margin: 2px 0 3px 0;
            font-weight: bold;
            font-size: 11px;
        }

        .date-line input {
            border: none;
            border-bottom: 1px solid #333;
            font-weight: normal;
            color: #0b1e36;
            outline: none;
            font-size: 14px;
            background: transparent;
        }

        .section-header {
            background: linear-gradient(to right, var(--main-color), #1a365d, var(--main-color));
            color: var(--gold-light);
            text-align: center;
            padding: 3px 4px;
            font-weight: bold;
            font-size: 11.5px;
            letter-spacing: 0.5px;
            border-radius: 3px 3px 0 0;
            margin-top: 3px;
            border-top: 1px solid var(--gold-color);
            border-bottom: 1px solid var(--gold-color);
        }

        .section-header::before, .section-header::after {
            content: " ✧ ";
            color: var(--gold-color);
        }

        .three-columns {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 5px;
            margin-bottom: 2px;
        }

        .column-box {
            border: 1px solid var(--border-color);
            border-radius: 3px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.75);
        }

        .field-row {
            display: flex;
            align-items: center;
            padding: 2px 4px;
            font-size: 10px;
        }

        .field-row label {
            font-weight: bold;
            white-space: nowrap;
            width: 75px;
        }

        .field-row input {
            border: none;
            border-bottom: 1px dotted #666;
            width: 100%;
            outline: none;
            font-size: 14px;
            font-weight: normal;
            color: #0b1e36;
            padding: 0;
            background: transparent;
        }

        .grid-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid var(--border-color);
            margin-bottom: 2px;
            background: rgba(255, 255, 255, 0.75);
        }

        .grid-table td {
            border: 1px solid var(--border-color);
            padding: 2px 4px;
            font-size: 10px;
        }

        .grid-table label {
            font-weight: bold;
        }

        .grid-table input {
            border: none;
            outline: none;
            width: 70%;
            font-size: 14px;
            font-weight: normal;
            color: #0b1e36;
            background: transparent;
        }

        .financial-box {
            border: 1px solid var(--border-color);
            margin-bottom: 2px;
            background: rgba(255, 255, 255, 0.75);
        }

        .terms-box {
            border: 1px solid var(--border-color);
            padding: 3px 8px;
            font-size: 9.5px;
            line-height: 1.25;
            margin-bottom: 2px;
            background: rgba(255, 255, 255, 0.75);
        }

        .terms-box ol {
            margin: 0;
            padding-right: 15px;
        }

        .terms-box li {
            margin-bottom: 1px;
            font-weight: 600;
        }

        .notes-container {
            display: flex;
            flex-direction: column;
            margin-bottom: 3px;
        }

        .notes-box {
            border: 1px solid var(--border-color);
            padding: 3px 8px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 55px; 
            background: rgba(255, 255, 255, 0.75);
        }

        .notes-box input {
            width: 100%;
            border: none;
            border-bottom: 1px dotted #888;
            outline: none;
            font-size: 14px;
            font-weight: normal;
            color: #0b1e36;
            padding: 1px 0;
            margin-bottom: 1px;
            background: transparent;
        }

        .price-qr-section {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            margin: 2px 0;
            background: rgba(253, 253, 253, 0.75);
            border: 1px dashed var(--gold-color);
            padding: 2px;
            border-radius: 4px;
        }

        .price-qr-box {
            background: #fff;
            padding: 2px;
            border: 1px solid var(--gold-color);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .price-qr-box canvas, .price-qr-box img {
            display: block;
            width: 42px !important;
            height: 42px !important;
        }

        .car-plate-display-container {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 6px 0;
        }

        .iraqi-car-plate-horizontal {
            background-color: #f4f4f4;
            border: 3px solid #111;
            border-radius: 6px;
            width: 440px;
            height: 56px;
            display: flex;
            flex-direction: row;
            align-items: center;
            box-shadow: 0 2px 6px rgba(0,0,0,0.25);
            overflow: hidden;
            position: relative;
        }

        .plate-main-section-h {
            flex-grow: 1;
            display: flex;
            flex-direction: row;
            justify-content: space-around;
            align-items: center;
            padding: 0 15px;
            font-family: 'Arial Black', Gadget, sans-serif;
            font-size: 28px;
            font-weight: 900;
            color: #000;
            letter-spacing: 3px;
            text-shadow: 0 0 3px rgba(255, 255, 0, 0.7), 0 0 6px rgba(255, 240, 100, 0.4);
            background: radial-gradient(circle, #ffffff 60%, #e6e6e6 100%);
        }

        .plate-side-strip-h {
            background-color: #ffffff;
            border-left: 3px solid #111;
            width: 42px;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 3px 0;
            font-family: 'Arial Black', Gadget, sans-serif;
            font-weight: 900;
            font-size: 12px;
            color: #000;
            letter-spacing: 1px;
        }

        .plate-side-strip-h span {
            line-height: 1;
        }

        .signatures-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 2px;
            text-align: center;
            position: relative;
            z-index: 1;
            background: rgba(255, 255, 255, 0.75);
        }

        .signatures-table td {
            border: 1px solid var(--border-color);
            padding: 4px;
            font-size: 10px;
            font-weight: bold;
            width: 33.33%;
            vertical-align: middle;
        }

        .sig-content-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 15px;
            min-height: 25px;
        }

        .btn-container {
            text-align: center;
            margin: 10px 0;
        }

        .btn-action {
            padding: 6px 14px;
            color: white;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            margin: 2px 5px;
        }

        .btn-print { background: #28a745; }
        .btn-pdf { background: #17a2b8; }
        .btn-waiver { background: #6f42c1; }
        .btn-installments { background: #d9534f; } /* زر قائمة الأقساط الجديد */
        .btn-promissory { background: #e83e8c; }
        .btn-new-contract { background: #20c997; }
        .btn-manage-contracts { background: #343a40; }
        .btn-unlock { background: #fd7e14; display: none; }
        .btn-reset { background: #dc3545; }
        .btn-delete-item { background: #6c757d; }
        .btn-manage-users { background: #6610f2; display: none; }

        @page {
            size: A4 portrait;
            margin: 0;
        }

        @media print {
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                color-adjust: exact !important;
            }

            html, body {
                width: 210mm;
                height: 297mm;
                background: none !important;
                padding: 0;
                margin: 0;
            }
            .contract-container {
                box-shadow: none;
                width: 210mm;
                height: 297mm;
                border: 4px double var(--gold-color) !important;
                outline: 2px solid var(--main-color) !important;
                outline-offset: -6px;
                margin: 0;
                padding: 5mm 10mm 4mm 10mm;
                page-break-after: avoid;
                page-break-inside: avoid;
            }
            .no-print, .lock-status-banner, #loginOverlay {
                display: none !important;
            }
            select.print-clean {
                appearance: none;
                -webkit-appearance: none;
                -moz-appearance: none;
                border: none !important;
                background: transparent !important;
                text-align: center;
            }
        }
    </style>
</head>
<body>

<!-- شاشة تسجيل الدخول الإجبارية -->
<div id="loginOverlay">
    <div class="login-box">
        <h2 id="loginTitle">تسجيل دخول الموظفين</h2>
        <div class="login-group">
            <label for="loginUsername">اسم المستخدم:</label>
            <input type="text" id="loginUsername" placeholder="أدخل اسمك">
        </div>
        <div class="login-group">
            <label for="loginPassword">كلمة المرور:</label>
            <input type="password" id="loginPassword" placeholder="أدخل كلمة المرور" onkeypress="checkEnter(event)">
        </div>
        <button type="button" class="btn-login" onclick="performLogin()">دخول للنظام</button>
        <div id="loginError" class="login-error"></div>
    </div>
</div>

<div class="contract-container">
    <div id="lockStatusBanner" class="lock-status-banner">⚠️ هذا العقد مؤرشف ومقفل ضد التعديل (لغرض الاستعراض والطباعة فقط)</div>
    <img src="logo.png" alt="Watermark" class="watermark-bg" id="watermarkLogo">

    <div class="main-content">
        <div class="header">
            <div class="header-left-group">
                <div class="contract-no-box">
                    <div class="title">رقم العقد</div>
                    <div class="number" id="contractNumDisplay">000001</div>
                </div>
                <div class="header-qr-box">
                    <div id="qrcode"></div>
                </div>
            </div>
            
            <div class="header-center">
                <h3>بسم الله الرحمن الرحيم</h3>
                <h1>عقد بيع وشراء مركبة</h1><br>
                <div class="sub-title">( عقد رسمي معتمد بين البائع والمشتري )</div>
            </div>
            
            <div class="logo-box">
                <img src="logo.png" alt="معرض أبو ظبي لتجارة السيارات" class="logo-img" id="mainLogo">
            </div>
        </div>

        <div class="date-line">
            التاريخ والوقت: <input type="text" id="fullDateTime" style="width: 240px;" readonly>
        </div>

        <div class="three-columns">
            <div class="column-box">
                <div class="section-header">أولاً: بيانات البائع مستلم المبلغ</div>
                <div class="field-row">
                    <label>الاسم الثلاثي :</label>
                    <input type="text" id="sellerName" list="sellersList" oninput="fillSellerData()" onblur="saveSellerToDatabase()">
                    <datalist id="sellersList"></datalist>
                </div>
                <div class="field-row"><label>رقم الهوية :</label><input type="text" id="sellerId" onblur="saveSellerToDatabase()"></div>
                <div class="field-row"><label>العنوان :</label><input type="text" id="sellerAddress" onblur="saveSellerToDatabase()"></div>
                <div class="field-row" style="font-size: 9.5px;">
                    <label style="width: 75px;"></label>
                    <span style="margin-left: 2px;">م</span><input type="text" id="sellerMahalla" style="width: 27%;" onblur="saveSellerToDatabase()">
                    <span style="margin: 0 2px;">ز</span><input type="text" id="sellerZuqaq" style="width: 27%;" onblur="saveSellerToDatabase()">
                    <span style="margin: 0 2px;">د</span><input type="text" id="sellerDar" style="width: 27%;" onblur="saveSellerToDatabase()">
                </div>
                <div class="field-row"><label>رقم الهاتف :</label><input type="text" id="sellerPhone" onblur="saveSellerToDatabase()"></div>
            </div>

            <div class="column-box">
                <div class="section-header">ثانياً: بيانات المشتري</div>
                <div class="field-row">
                    <label>الاسم الثلاثي :</label>
                    <input type="text" id="buyerName" list="buyersList" oninput="fillBuyerData()" onblur="saveBuyerToDatabase()">
                    <datalist id="buyersList"></datalist>
                </div>
                <div class="field-row"><label>رقم الهوية :</label><input type="text" id="buyerId" onblur="saveBuyerToDatabase()"></div>
                <div class="field-row"><label>العنوان :</label><input type="text" id="buyerAddress" onblur="saveBuyerToDatabase()"></div>
                <div class="field-row" style="font-size: 9.5px;">
                    <label style="width: 75px;"></label>
                    <span style="margin-left: 2px;">م</span><input type="text" id="buyerMahalla" style="width: 27%;" onblur="saveBuyerToDatabase()">
                    <span style="margin: 0 2px;">ز</span><input type="text" id="buyerZuqaq" style="width: 27%;" onblur="saveBuyerToDatabase()">
                    <span style="margin: 0 2px;">د</span><input type="text" id="buyerDar" style="width: 27%;" onblur="saveBuyerToDatabase()">
                </div>
                <div class="field-row"><label>رقم الهاتف :</label><input type="text" id="buyerPhone" onblur="saveBuyerToDatabase()"></div>
            </div>

            <div class="column-box">
                <div class="section-header">ثالثاً: بيانات صاحب السنوية</div>
                <div class="field-row">
                    <label>الاسم الثلاثي :</label>
                    <input type="text" id="ownerName" list="ownersList" oninput="fillOwnerData()" onblur="saveOwnerToDatabase()">
                    <datalist id="ownersList"></datalist>
                </div>
                <div class="field-row"><label>رقم الهوية :</label><input type="text" id="ownerId" onblur="saveOwnerToDatabase()"></div>
                <div class="field-row"><label>العنوان :</label><input type="text" id="ownerAddress" onblur="saveOwnerToDatabase()"></div>
                <div class="field-row" style="font-size: 9.5px;">
                    <label style="width: 75px;"></label>
                    <span style="margin-left: 2px;">م</span><input type="text" id="ownerMahalla" style="width: 27%;" onblur="saveOwnerToDatabase()">
                    <span style="margin: 0 2px;">ز</span><input type="text" id="ownerZuqaq" style="width: 27%;" onblur="saveOwnerToDatabase()">
                    <span style="margin: 0 2px;">د</span><input type="text" id="ownerDar" style="width: 27%;" onblur="saveOwnerToDatabase()">
                </div>
                <div class="field-row"><label>رقم الهاتف :</label><input type="text" id="ownerPhone" onblur="saveOwnerToDatabase()"></div>
            </div>
        </div>

        <div class="section-header">رابعاً: بيانات المركبة</div>
        <table class="grid-table">
            <tr>
                <td style="width: 50%;">
                    <label>نوع المركبة :</label> 
                    <input type="text" id="carType" onblur="saveCarToDatabase()" style="width: 65%;">
                </td>
                <td style="width: 50%;"><label>الموديل :</label> <input type="text" id="carModel" onblur="saveCarToDatabase()" style="width: 70%;"></td>
            </tr>
            <tr>
                <td><label>اللون :</label> <input type="text" id="carColor" onblur="saveCarToDatabase()" style="width: 70%;"></td>
                <td><label>رقم الشاصي :</label> <input type="text" id="vinNumber" oninput="updateQRCode()" onblur="saveCarToDatabase()" style="width: 70%;"></td>
            </tr>
            <tr>
                <td><label>رقم السنوية :</label> <input type="text" id="carDocNum" onblur="saveCarToDatabase()" style="width: 70%;"></td>
                <td>
                    <label>رقم اللوحة :</label> 
                    <input type="text" id="plateNumber" list="carsList" placeholder="" oninput="fillCarData(); updatePlateDisplay();" onblur="saveCarToDatabase()" style="width: 26%;">
                    <datalist id="carsList"></datalist>
                    <select id="plateLetterSelect" class="print-clean" onchange="updatePlateDisplay(); saveCarToDatabase();" style="width: 22%; font-size: 12px; font-weight: bold; border: 1px solid #333; border-radius: 3px; background: #fff; outline: none; padding: 1px;">
                        <option value="" selected disabled></option>
                        <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option><option value="E">E</option><option value="F">F</option><option value="G">G</option><option value="H">H</option><option value="I">I</option><option value="J">J</option><option value="K">K</option><option value="L">L</option><option value="M">M</option><option value="N">N</option><option value="O">O</option><option value="P">P</option><option value="Q">Q</option><option value="R">R</option><option value="S">S</option><option value="T">T</option><option value="U">U</option><option value="V">V</option><option value="W">W</option><option value="X">X</option><option value="Y">Y</option><option value="Z">Z</option>
                    </select>
