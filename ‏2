                                      "إحدى عشر", "اثنا عشر", "ثلاثة عشر", "أربعة عشر", "خمسة عشر", "ستة عشر", "سبعة عشر", "ثمانية عشر", "تسعة عشر"];
                        const tens = ["", "", "عشرون", "ثلاثون", "أربعون", "خمسون", "ستون", "سبعون", "ثمانون", "تسعون"];
                        const hundreds = ["", "مائة", "مائتان", "ثلاثمائة", "أربعمائة", "خمسمائة", "ستمائة", "سبعمائة", "ثمانمائة", "تسعمائة"];

                        function convertHundreds(n) {
                            let str = "";
                            let h = Math.floor(n / 100);
                            let rem = n % 100;
                            if (h > 0) str += hundreds[h];
                            if (rem > 0) {
                                if (str !== "") str += " و";
                                if (rem < 20) str += ones[rem];
                                else {
                                    let t = Math.floor(rem / 10);
                                    let o = rem % 10;
                                    if (o > 0) str += ones[o] + " و" + tens[t];
                                    else str += tens[t];
                                }
                            }
                            return str;
                        }

                        if (num === 500000000) return "خمس مائة مليون";

                        let millions = Math.floor(num / 1000000);
                        let remainderAfterMillions = num % 1000000;
                        let thousands = Math.floor(remainderAfterMillions / 1000);
                        let units = remainderAfterMillions % 1000;

                        let parts = [];
                        if (millions > 0) {
                            let milText = "";
                            if (millions === 1) milText = "مليون واحد";
                            else if (millions === 2) milText = "مليونان";
                            else if (millions >= 3 && millions <= 10) milText = convertHundreds(millions) + " ملايين";
                            else milText = convertHundreds(millions) + " مليوناً";
                            parts.push(milText);
                        }

                        if (thousands > 0) {
                            let thouText = "";
                            if (thousands === 1) thouText = "ألف واحد";
                            else if (thousands === 2) thouText = "ألفان";
                            else if (thousands >= 3 && thousands <= 10) thouText = convertHundreds(thousands) + " آلاف";
                            else thouText = convertHundreds(thousands) + " ألفاً";
                            parts.push(thouText);
                        }

                        if (units > 0) parts.push(convertHundreds(units));

                        return parts.join(" و");
                    }

                    function formatAndWordPromissory(input) {
                        let cleanVal = input.value.replace(/\\D/g, "");
                        if (cleanVal !== "") {
                            let num = parseInt(cleanVal, 10);
                            if (num > 500000000) {
                                num = 500000000;
                            }
                            input.value = num.toLocaleString();
                        } else {
                            input.value = "";
                        }
                        updatePromissoryWords();
                    }

                    function updatePromissoryWords() {
                        let rawVal = document.getElementById('pNum').value.replace(/,/g, '');
