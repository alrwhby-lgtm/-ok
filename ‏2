    function calculateFinancials() {
        if (isContractLocked) return;
        let price = parseInt(document.getElementById('priceNum').value) || 0;
        let paid = parseFloat(document.getElementById('paidNum').value) || 0;
        let selectedCurrency = document.getElementById('currencySelect').value;

        document.getElementById('paidCurrencyLabel').innerText = selectedCurrency;
        document.getElementById('remainingCurrencyLabel').innerText = selectedCurrency;

        if (price > 0) {
            let currencyText = selectedCurrency === 'دينار' ? "دينار عراقي لا غير" : "دولار أمريكي لا غير";
            document.getElementById('priceWords').value = tafqeet(price) + " " + currencyText;
        } else {
            document.getElementById('priceWords').value = '';
        }

        let remaining = price - paid;
        if (price > 0 || paid > 0) {
            document.getElementById('remainingNum').value = remaining >= 0 ? remaining : 0;
        } else {
            document.getElementById('remainingNum').value = '';
        }

        updatePriceQRCode();
    }

    function tafqeet(num) {
        num = parseInt(num);
        if (isNaN(num) || num <= 0) return "";
        if (num > 500000000) return "المبلغ أكبر من 500 مليون";

        const ones = ["", "واحد", "اثنان", "ثلاثة", "أربعة", "خمسة", "ستة", "سبعة", "ثمانية", "تسعة", "عشرة",
                      "إحدى عشر", "اثنا عشر", "ثلاثة عشر", "أربعة عشر", "خمسة عشر", "ستة عشر", "سبعة عشر", "ثمانية عشر", "تسعة عشر"];
        const tens = ["", "", "عشرون", "ثلاثون", "أربعون", "خمسون", "ستون", "سبعون", "ثمانون", "تسعون"];
        const hundreds = ["", "مائة", "مائتان", "ثلاثمائة", "أربعمائة", "خمسمائة", "ستمائة", "سبعمائة", "ثمانمائة", "تسعمائة"];

        function convertHundreds(n) {
            let str = "";
            let h = Math.floor(n / 100);
            let rem = n % 100;
            if (h > 0) str += hundreds[h];
            if (rem > 0) {
                if (str !== "") str += " و";
                if (rem < 20) str += ones[rem];
                else {
                    let t = Math.floor(rem / 10);
                    let o = rem % 10;
                    if (o > 0) str += ones[o] + " و" + tens[t];
                    else str += tens[t];
                }
            }
            return str;
        }

        if (num === 500000000) return "خمس مائة مليون";

        let millions = Math.floor(num / 1000000);
        let remainderAfterMillions = num % 1000000;
        let thousands = Math.floor(remainderAfterMillions / 1000);
        let units = remainderAfterMillions % 1000;

        let parts = [];
        if (millions > 0) {
            let milText = "";
            if (millions === 1) milText = "مليون واحد";
            else if (millions === 2) milText = "مليونان";
            else if (millions >= 3 && millions <= 10) milText = convertHundreds(millions) + " ملايين";
            else milText = convertHundreds(millions) + " مليوناً";
            parts.push(milText);
        }

        if (thousands > 0) {
            let thouText = "";
            if (thousands === 1) thouText = "ألف واحد";
            else if (thousands === 2) thouText = "ألفان";
            else if (thousands >= 3 && thousands <= 10) thouText = convertHundreds(thousands) + " آلاف";
            else thouText = convertHundreds(thousands) + " ألفاً";
            parts.push(thouText);
        }

        if (units > 0) parts.push(convertHundreds(units));

        return parts.join(" و");
    }
